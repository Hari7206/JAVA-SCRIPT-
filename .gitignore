# Common NPM log files
npm-debug.log*
.npm/
.eslintcache

# Yarn v2+ log file
.yarn/cache

# 4. Build Output and Temporary Folders
#######################################
# Build output folders (where compiled code goes)
/dist
/build
/out
/coverage
